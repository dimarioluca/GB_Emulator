import { Button, VerticalBox, HorizontalBox, LineEdit, StandardListView } from "std-widgets.slint";

export component LauncherWindow inherits Window {
    title: "Game Boy Emulator";
    width: 520px;
    height: 380px;

    in-out property <string> folder-path;
    in-out property <[StandardListViewItem]> games;
    in-out property <int> selected-index: -1;
    in-out property <bool> busy: false;

    callback select-folder-clicked();
    callback start-emulator-clicked();

    VerticalBox {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "Game Boy Emulator";
            font-size: 22px;
            horizontal-alignment: center;
        }

        HorizontalBox {
            spacing: 8px;
            LineEdit {
                text: root.folder-path;
                read-only: true;
                placeholder-text: "No folder selected...";
            }
            Button {
                text: "Select Folder";
                enabled: !root.busy;
                clicked => { root.select-folder-clicked(); }
            }
        }

        StandardListView {
            model: root.games;
            current-item <=> root.selected-index;
        }

        Button {
            text: "Start Emulator";
            enabled: root.selected-index >= 0 && !root.busy;
            clicked => { root.start-emulator-clicked(); }
        }
    }
}